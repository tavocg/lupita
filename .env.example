# URL base de tu servidor Ollama, sin /api/chat.
OLLAMA_BASE_URL=http://localhost:11434
# Obligatorio: nombre exacto de un modelo que ya esté instalado en Ollama.
OLLAMA_MODEL=
OLLAMA_TIMEOUT=180

# true genera borradores; false permite que Hugo publique las noticias.
NEWS_DRAFT=true

# Usuario propietario de los archivos creados por Docker (id -u e id -g).
LOCAL_UID=1000
LOCAL_GID=1000
