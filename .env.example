# URL base de tu servidor Ollama, sin /api/chat.
OLLAMA_BASE_URL=http://localhost:11434
# Obligatorio para process/ingest; stage no necesita un modelo.
OLLAMA_MODEL=
OLLAMA_TIMEOUT=180

# Tras la IA: true conserva borradores; false publica. stage siempre crea drafts.
NEWS_DRAFT=true

# Usuario propietario de los archivos creados por Docker (id -u e id -g).
LOCAL_UID=1000
LOCAL_GID=1000
