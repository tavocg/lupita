# Las opciones CLI prevalecen sobre el entorno, y el entorno sobre .env.
OLLAMA_BASE_URL=http://localhost:11434
# Obligatorio para ingest/process/serve; stage/index/scrape no necesitan modelo.
OLLAMA_MODEL=
OLLAMA_TIMEOUT=180
# Opcional: archivo UTF-8 accesible dentro del contenedor.
EDITOR_INSTRUCTIONS_FILE=
# Llave privada SSH: ruta al archivo o contenido OpenSSH en NEWS_SSH_KEY.
NEWS_SSH_KEY=
# Alternativa recomendada para GitHub: token fino de corta duración.
GITHUB_TOKEN=

NEWS_COMMAND=ingest
NEWS_SOURCE=all
# 0 o all = sin límite; positivo = máximo de noticias/consultas por etapa.
NEWS_LIMIT=0
# Días en America/Costa_Rica. ISO con hora requiere zona. all = sin frontera.
NEWS_FROM=yesterday
NEWS_UNTIL=now
# Segundos después de terminar cada ciclo de serve (8 horas).
NEWS_INTERVAL=28800
NEWS_DRY_RUN=false
# false publica tras procesar; stage siempre crea borradores.
NEWS_DRAFT=true
# Clave gratuita de la API Pexels; el worker busca imágenes en cada ciclo.
PEXELS_API_KEY=
# Noticias recientes sin imagen por ciclo (2 por defecto).
NEWS_IMAGE_LIMIT=2
NEWS_INDEX_PATH=.news-index.json
# Opcionales y excluyentes; rutas internas en Docker, solo para ejecuciones únicas.
NEWS_INPUT=
NEWS_FEED_FILE=

# Rutas locales; Compose fija /app/content y /app/.pipeline dentro del contenedor.
CONTENT_DIR=content
STATE_DIR=.pipeline
# Directorios del servidor que Compose monta; relativos a compose.yaml o absolutos.
CONTENT_VOLUME=./content
STATE_VOLUME=./.pipeline
# Esperar la consulta IA actual al detener el servicio.
SERVICE_STOP_GRACE_PERIOD=5m
LOCAL_UID=1000
LOCAL_GID=1000
